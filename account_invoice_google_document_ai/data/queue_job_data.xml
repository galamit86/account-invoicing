<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="queue_job_channel_invoice_ocr" model="queue.job.channel">
        <field name="name">invoice_ocr</field>
        <field name="parent_id" ref="queue_job.channel_root" />
    </record>
    <record id="queue_job_function_extract_invoice_google" model="queue.job.function">
        <field name="model_id" ref="account.model_account_move" />
        <field name="method">_extract_invoice_with_google</field>
        <field name="channel_id" ref="queue_job_channel_invoice_ocr" />
        <field name="retry_pattern" eval="{1: 60, 2: 300, 3: 900}" />
        <field name="on_fail_method">_invoice_ocr_job_failed</field>
    </record>
    <record id="queue_job_function_apply_invoice_ocr" model="queue.job.function">
        <field name="model_id" ref="account.model_account_move" />
        <field name="method">_apply_invoice_ocr_result</field>
        <field name="channel_id" ref="queue_job_channel_invoice_ocr" />
    </record>
</odoo>
