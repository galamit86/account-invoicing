<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_invoice_ocr" model="ir.ui.view">
        <field name="name">res.config.settings.form.invoice.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="account_ocr_settings" position="before">
                <setting
                    id="account_invoice_google_document_ai_settings"
                    string="Google invoice extraction"
                    help="Extract emailed and uploaded vendor invoice PDFs with Google Document AI."
                    company_dependent="1"
                >
                    <field name="invoice_ocr_google_mode" />
                    <div
                        class="content-group"
                        invisible="invoice_ocr_google_mode == 'disabled'"
                    >
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_google_project"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_google_project" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_google_location"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_google_location" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_google_processor"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_google_processor" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_google_processor_version"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_google_processor_version" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_google_credentials"
                                class="col-lg-3 o_light_label"
                            />
                            <field
                                name="invoice_ocr_google_credentials"
                                filename="invoice_ocr_google_credentials_filename"
                            />
                            <field
                                name="invoice_ocr_google_credentials_filename"
                                invisible="1"
                            />
                        </div>
                        <div class="alert alert-warning mt8" role="alert">
                            The service-account private key is stored in the Odoo
                            database and its backups. Restrict backup access and rotate
                            the key when access changes.
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_confidence_threshold"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_confidence_threshold" />
                        </div>
                        <div class="row mt16">
                            <label
                                for="invoice_ocr_auto_post"
                                class="col-lg-3 o_light_label"
                            />
                            <field name="invoice_ocr_auto_post" />
                        </div>
                        <button
                            name="action_test_invoice_ocr_google_connection"
                            string="Test Google Connection"
                            type="object"
                            class="btn-secondary mt8"
                            invisible="not invoice_ocr_google_credentials or not invoice_ocr_google_project or not invoice_ocr_google_processor"
                        />
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
